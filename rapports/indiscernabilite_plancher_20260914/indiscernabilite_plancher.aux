\@writefile{toc}{\contentsline {section}{\numberline {1}Les trois constructions sont indiscernables}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {[MESURÉ]}\ Figure « erreur vs temps » du rapport de sélection, répliquée à cinq graines par le même script (\texttt  {select\_terminal\_function\_at\_strike.py}). Erreur relative $\ell ^2$ sur les noeuds $s_i>B+\varepsilon _{\mathrm  {coin}}=0.7$ d'une tranche $t_j$ (grille $s\in [B,2]$, $400$ noeuds ; $t\in [0,T]$, $200$ noeuds) du prix, du Delta et du Gamma. Trait plein : médiane sur les graines ; traits fins : graines. Les trois médianes coïncident à l'épaisseur du trait près sur les trois panneaux et à tout $t$ ; le faisceau des graines d'une construction contient les médianes des deux autres.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:erreur-vs-temps}{{1}{1}{\mesure \ Figure « erreur vs temps » du rapport de sélection, répliquée à cinq graines par le même script (\code {select\_terminal\_function\_at\_strike.py}). Erreur relative $\ell ^2$ sur les noeuds $s_i>B+\epscoin =0.7$ d'une tranche $t_j$ (grille $s\in [B,2]$, $400$ noeuds ; $t\in [0,T]$, $200$ noeuds) du prix, du Delta et du Gamma. Trait plein : médiane sur les graines ; traits fins : graines. Les trois médianes coïncident à l'épaisseur du trait près sur les trois panneaux et à tout $t$ ; le faisceau des graines d'une construction contient les médianes des deux autres}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {[MESURÉ]}\ Mêmes courbes, une ligne par construction, les cinq graines superposées, mêmes ordonnées par colonne. Dispersion entre graines d'une même construction : facteur $\simeq 1.5$ sur le prix, $\simeq 2$ sur le Gamma, à comparer aux écarts entre médianes de la figure~\ref  {fig:erreur-vs-temps}.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:par-construction}{{2}{2}{\mesure \ Mêmes courbes, une ligne par construction, les cinq graines superposées, mêmes ordonnées par colonne. Dispersion entre graines d'une même construction : facteur $\simeq 1.5$ sur le prix, $\simeq 2$ sur le Gamma, à comparer aux écarts entre médianes de la figure~\ref {fig:erreur-vs-temps}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {[MESURÉ]}\ Métriques par graine (points) et médiane (losange) sur le domaine $\Omega $ entier ($300\times 100$ noeuds) : erreur relative hors fenêtre du coin $\Omega \setminus N_{0.1}$ (métrique de comparaison), erreur relative globale (fenêtre incluse, contaminée par la discontinuité du coin), erreur relative dans la fenêtre (diagnostic), meilleur loss intérieur. Les intervalles [min, max] des trois constructions se recouvrent pour chaque métrique ; le meilleur loss du split est $3$ fois plus bas sans que son erreur le soit.}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:par-graine}{{3}{2}{\mesure \ Métriques par graine (points) et médiane (losange) sur le domaine $\Omega $ entier ($300\times 100$ noeuds) : erreur relative hors fenêtre du coin $\Omega \setminus N_{0.1}$ (métrique de comparaison), erreur relative globale (fenêtre incluse, contaminée par la discontinuité du coin), erreur relative dans la fenêtre (diagnostic), meilleur loss intérieur. Les intervalles [min, max] des trois constructions se recouvrent pour chaque métrique ; le meilleur loss du split est $3$ fois plus bas sans que son erreur le soit}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Chiffres.}{3}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Pourquoi la version précédente classait.}{3}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Leur erreur commune est un plancher, et il est expliqué}{3}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {[MESURÉ]}\ Budget d'entraînement contre erreur, de $20\,000$ à $50\,000$ itérations (mêmes graines, même machine, même nombre de threads). Le meilleur loss intérieur décroît d'un facteur $11$, $30$ et $10$ ; l'erreur relative sur $\Omega \setminus N_{0.1}$ d'un facteur $1.4$, $1.2$ et $1.05$ seulement, vers une valeur commune $0.12$--$0.13$. Tiretés : le plancher prédit de la figure~\ref  {fig:plancher}, $0.112$.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:budget}{{4}{3}{\mesure \ Budget d'entraînement contre erreur, de $20\,000$ à $50\,000$ itérations (mêmes graines, même machine, même nombre de threads). Le meilleur loss intérieur décroît d'un facteur $11$, $30$ et $10$ ; l'erreur relative sur $\Omega \setminus N_{0.1}$ d'un facteur $1.4$, $1.2$ et $1.05$ seulement, vers une valeur commune $0.12$--$0.13$. Tiretés : le plancher prédit de la figure~\ref {fig:plancher}, $0.112$}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Le plancher est le défaut de trace terminale de l'ansatz.}{3}{section*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {[MESURÉ]}\ Erreur relative par tranche de $s$ (tout $t$, fenêtre $N_{0.1}$ retirée) : plancher prédit par $\delta $ seul, sans réseau et sans construction (tiretés noirs), contre les erreurs mesurées des quinze runs (médianes en trait plein, graines en points). Sur $[0.6,0.7]$, $[0.7,1]$ et $[1,2]$ : prédit $0.210$, $0.085$, $0.047$ ; mesuré $0.204$--$0.216$, $0.075$--$0.083$, $0.049$--$0.059$. La tranche $[2,s_\infty ]$ est une composante distincte (far-field non contraint, dépendante de la graine), non expliquée par $\delta $.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:plancher}{{5}{4}{\mesure \ Erreur relative par tranche de $s$ (tout $t$, fenêtre $N_{0.1}$ retirée) : plancher prédit par $\delta $ seul, sans réseau et sans construction (tiretés noirs), contre les erreurs mesurées des quinze runs (médianes en trait plein, graines en points). Sur $[0.6,0.7]$, $[0.7,1]$ et $[1,2]$ : prédit $0.210$, $0.085$, $0.047$ ; mesuré $0.204$--$0.216$, $0.075$--$0.083$, $0.049$--$0.059$. La tranche $[2,s_\infty ]$ est une composante distincte (far-field non contraint, dépendante de la graine), non expliquée par $\delta $}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {[MESURÉ]}\ Contrôle : erreur relative sur le complément d'une fenêtre exclue, pour trois formes de fenêtre autour du coin, en fonction de l'aire exclue. Aucune forme ne fait décroître l'erreur : le plancher n'est pas un artefact de la fenêtre $N_{0.1}$ ; il est diffusé depuis la couche $[B,B+\varepsilon _{\mathrm  {coin}}]$ vers l'intérieur, comme $w$ le prédit.}}{5}{figure.6}\protected@file@percent }
\newlabel{fig:fenetre}{{6}{5}{\mesure \ Contrôle : erreur relative sur le complément d'une fenêtre exclue, pour trois formes de fenêtre autour du coin, en fonction de l'aire exclue. Aucune forme ne fait décroître l'erreur : le plancher n'est pas un artefact de la fenêtre $N_{0.1}$ ; il est diffusé depuis la couche $[B,B+\epscoin ]$ vers l'intérieur, comme $w$ le prédit}{figure.6}{}}
