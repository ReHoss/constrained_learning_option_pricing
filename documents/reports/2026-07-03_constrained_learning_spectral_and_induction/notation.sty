% --- network-reachable subspace and its complement (spectral bias) ---
\newcommand{\reachableSet}{\mathcal{S}}                 % network-reachable subspace
\newcommand{\reachableSetPerp}{\reachableSet^{\perp}}   % uncancellable complement
\newcommand{\projReachablePerp}{\Pi_{\reachableSetPerp}}% orthogonal projection onto it

% --- Fourier / spectral objects ---
\newcommand{\wavenumber}{\xi}                           % spatial wavenumber (NOT k: k is the induction stage index)
\newcommand{\fouriertransform}[1]{\widehat{#1}}         % Fourier transform of its argument
\newcommand{\regularityIndex}{\rho}                     % order of the lowest discontinuous derivative of g
\newcommand{\operatorHalfOrder}{p}                      % elliptic generator has order 2p
\newcommand{\cutoffWavenumber}{\wavenumber^{\star}}     % effective spectral cutoff (network reach)

% --- metrics ---
\newcommand{\relLtwo}{\eta}                             % relative L^2 error against the reference
