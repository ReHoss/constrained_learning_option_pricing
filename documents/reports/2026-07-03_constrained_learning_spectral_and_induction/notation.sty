% ---------------------------------------------------------------------------
% PDE setting: domain, reals, boundary, normal
% ---------------------------------------------------------------------------
\newcommand{\R}{\mathbb{R}}
\newcommand{\domain}{\Omega}
\newcommand{\boundary}{\partial \Omega}
\newcommand{\distanceToBoundary}{\mathrm{d}_{\boundary}}  % distance to boundary (vanishes on \boundary)
\newcommand{\distanceFunction}{\mathrm{d}_{\domain}}      % distance function to the domain boundary
\newcommand{\normal}{n}

% ---------------------------------------------------------------------------
% PDE operators and spaces (long names + short aliases)
% ---------------------------------------------------------------------------
\newcommand{\pdeOperator}{\mathcal{L}}           % PDE (interior) operator
\newcommand{\pdeOperatorEstimate}{\widehat{\pdeOperator}}
\newcommand{\linearPdeOperator}{\mathcal{L}}     % linear PDE operator (strong form, e.g. -\Delta)
\newcommand{\boundaryOperator}{\mathcal{B}}      % boundary operator
\newcommand{\constraintTransformationOperator}{\mathcal{T}}  % maps estimator onto BC-satisfying subspace
\newcommand{\dataOperator}{\mathcal{D}}          % data/observation operator
\newcommand{\lossFunction}{\mathcal{L}}           % generic loss functional
\newcommand{\lossObjective}{\mathcal{J}}          % objective/loss functional (e.g. J: U -> R)
\newcommand{\constraintOperator}{\mathcal{G}}     % generic constraint / coupling operator
\newcommand{\solutionSpace}{\mathcal{U}}          % solution space
\newcommand{\constraintSpace}{\mathcal{C}}        % constraint space
\newcommand{\solutionSpaceDimension}{p}            % dimension of solution space (e.g. \solutionSpace \subset \R^{\solutionSpaceDimension})

% ---------------------------------------------------------------------------
% Mathematical finance: payoff, exercise region, risk-neutral measure
% (used by Bermudan option pricing notes; aligned with CAL bermudan_iterations.tex)
% ---------------------------------------------------------------------------
\newcommand{\payoff}{g}                          % intrinsic payoff: g(s) = (K-s)^+ for put, max(0, s-K) for call (CAL convention)
\newcommand{\compactPayoff}{\payoff}             % alias kept when emphasising the compact-form max(0, s-K)
\newcommand{\exerciseRegion}{\mathcal{E}}        % early-exercise region of an American/Bermudan claim
\newcommand{\riskNeutralMeasure}{\mathbb{Q}}     % risk-neutral probability measure

% ---------------------------------------------------------------------------
% Bermudan iterations / PINN ansatz (CAL bermudan_iterations.tex)
% Naming kept consistent with CAL's notes:
%   \architectureOutput   = \Phi  -- full architecture output  \Phi_\theta
%   \freeNetwork          = \Psi  -- free neural network       \Psi_\theta
%   \terminalExtension    = h     -- hard-constraint extension h(T,x)=g(x)
%   \interpolationCoefficient = b -- interpolation coefficient with b(T)=1
%   \architectureOutput_\theta = (1-b(t)) \freeNetwork_\theta + h(t,x)
%   (stage-k effective payoff: written inline as h_{k,\bar\theta_{k+1}}(\cdot, t_k))
% ---------------------------------------------------------------------------
\newcommand{\architectureOutput}{\Phi}                   % full architecture output: \architectureOutput_\theta
\newcommand{\freeNetwork}{\Psi}                          % free neural network: \freeNetwork_\theta
\newcommand{\terminalExtension}{h}                       % terminal-data extension h(t,x) with h(T,x) = g(x)
\newcommand{\interpolationCoefficient}{b}                % b(t) with b(T)=1, used in \architectureOutput = (1-b)\freeNetwork + b h
\newcommand{\generatorUnderlying}{\pdeOperator^{\stateProcess}}  % infinitesimal generator of the underlying X under Q
\newcommand{\continuationValue}{\ell}                    % \continuationValue(s,\tau) := E[g(S_T) e^{-r(T-\tau)} | S_\tau=s]
\newcommand{\implicitStrike}{\kappa}                     % \implicitStrike(s,\tau) := s - \continuationValue(s,\tau)
\newcommand{\pdeResidual}{R}                             % BSm residual: R_\architectureOutput := \partial_t \Phi + L^X \Phi - r \Phi
\newcommand{\smoothMax}{\mathcal{M}}                     % one-parameter family of smoothed max operators (not in CAL's notes)
\newcommand{\smoothMaxCM}{\smoothMax^{\mathrm{CM}}}      % Chen-Mangasarian smoothing
\newcommand{\smoothingScale}{\varepsilon}                % smoothing bandwidth in \smoothMax_\varepsilon
\newcommand{\frakL}{\mathfrak{L}}                        % PINN loss functional (CAL)
\newcommand{\frakC}{\mathfrak{C}}                        % compensator loss functional (CAL)

% ---------------------------------------------------------------------------
% Vector-field / PDE solution and RHS (one entry or scalar component)
% ---------------------------------------------------------------------------
\newcommand{\solutionField}{u}                    % solution field (one component: u, u_i)
\newcommand{\sourceTerm}{f}                      % RHS in domain (e.g. T u = f)
\newcommand{\boundaryRhs}{g}                     % RHS on boundary (e.g. B u = g)
\newcommand{\initialCondition}{\solutionField_0} % initial condition (e.g. I u = u_0)

% Running example: heat equation (for use in slides)
\newcommand{\heateq}{\partial_{\timePoint} \solutionField - \partial_{\spacePoint\spacePoint} \solutionField = \sourceTerm\;\text{ on }\;(0,L)\times(0,\timeHorizon),\;\; \solutionField=0\;\text{ at }\spacePoint=0,L,\;\; \solutionField(\cdot,0)=\solutionField_0}

